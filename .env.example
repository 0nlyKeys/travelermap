# Copy to .env.local and fill in. .env.local is gitignored.

# CARTO Basemaps API key — request one free (no account) at:
#   https://carto.com/basemaps/apikey/
# Required since 2026-09-23: keyless CARTO raster tiles still return HTTP 200
# but every tile is stamped "API KEY REQUIRED".
#
# If this is unset the map silently falls back to Esri World Gray Canvas
# (see src/features/mapa/lib/mapTiles.ts), so the app still renders.
NEXT_PUBLIC_CARTO_KEY=
